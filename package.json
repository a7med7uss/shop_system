{
  "name": "storeflow",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first retail inventory and point-of-sale desktop system",
  "author": "Ahmed Hussein Emara",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --target=node24 --external:electron --external:better-sqlite3 --outfile=dist-electron/main.cjs && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --target=node24 --external:electron --outfile=dist-electron/preload.cjs",
    "typecheck": "tsc --noEmit",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "test:database": "node -e \"require('fs').mkdirSync('.ci',{recursive:true})\" && esbuild scripts/database-smoke.ts --bundle --platform=node --format=cjs --target=node24 --external:better-sqlite3 --outfile=.ci/database-smoke.cjs && node .ci/database-smoke.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@fontsource/tajawal": "^5.3.0",
    "@fontsource/manrope": "^5.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.ahmedhusseinemara.storeflow",
    "productName": "StoreFlow",
    "copyright": "Copyright © 2026 Ahmed Hussein Emara",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "StoreFlow-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StoreFlow",
      "deleteAppDataOnUninstall": false
    }
  }
}
